# SolarScope Configuration Template
# Copy this file to .env and fill in values as appropriate.

# Renewables.ninja API Configuration
# Get a free API token from https://www.renewables.ninja/profile
# If left empty, SolarScope operates cleanly in local development fixture mode.
RENEWABLES_NINJA_TOKEN=

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Settings
DEFAULT_DATASET=merra2
REQUEST_TIMEOUT_SECONDS=30
MAX_SIMULATION_DAYS=366
