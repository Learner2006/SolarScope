# Ensure credentials, operating system metadata, build artifacts, and test caches
# are excluded from all git archive source distributions.
.env* export-ignore
.DS_Store export-ignore
__MACOSX export-ignore
._* export-ignore
frontend/dist export-ignore
frontend/dist-ssr export-ignore
node_modules export-ignore
.pytest_cache export-ignore
.coverage export-ignore
htmlcov export-ignore
.mypy_cache export-ignore
.ruff_cache export-ignore
.gitattributes export-ignore
.gitignore export-ignore
