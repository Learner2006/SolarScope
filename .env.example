# SolarScope Configuration Template
# Copy this file to .env and fill in values as appropriate.

# ==============================================================================
# Backend Configuration
# ==============================================================================

# Runtime Environment: 'development' (default) or 'production'
# In development, localhost origins (5173, 3000, etc.) are automatically allowed.
# In production, wildcards ('*') are strictly rejected at startup, and only explicit
# BACKEND_CORS_ORIGINS are accepted.
ENVIRONMENT=development

# Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated list of web origins, without trailing slashes)
# In production, set this to your deployed frontend origin(s):
# BACKEND_CORS_ORIGINS=https://solarscope.example.com,https://app.solarscope.example.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# (CORS_ORIGINS is also supported as an alias for backwards compatibility)

# Renewables.ninja API Configuration
# Get a free API token from https://www.renewables.ninja/profile
# SECURITY NOTE: This secret must remain EXCLUSIVELY on the backend.
# Never expose it via frontend variables, logs, or client-facing responses.
# If left empty, SolarScope operates cleanly in theoretical clear-sky and fixture mode.
RENEWABLES_NINJA_TOKEN=

# Simulation & Resource Settings
DEFAULT_DATASET=merra2
REQUEST_TIMEOUT_SECONDS=30
MAX_SIMULATION_DAYS=366
MAX_CONCURRENT_SIMULATIONS=20
MAX_ANALYSES_CAPACITY=100

# ==============================================================================
# Frontend Build Configuration (Vite)
# ==============================================================================
# Optional: Set this at build time when hosting the frontend on a separate domain
# from the backend API (e.g. Vercel, Netlify, Cloudflare Pages, S3/CloudFront).
# If omitted or empty, the frontend defaults to relative '/api' (works with Vite proxy
# and same-origin reverse proxies like Nginx/Caddy).
# VITE_API_BASE_URL=https://api.solarscope.example.com
